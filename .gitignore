# Ignore macOS system files
.DS_Store

# Ignore build artifacts, audio test clips, and backups
__pycache__/
*.bak
*.wav
/WK7-software-for-unlocked-bootloader/wk7-build/backup-2026-10-02/
/WK7-software-for-unlocked-bootloader/wk7-build/stage1/DSP
/WK7-software-for-unlocked-bootloader/wk7-build/stage1/start.sh

# Ignore downloaded archives
/WK7-software-for-unlocked-bootloader/wk7-build/dl/

# Ignore LG firmware images, partition backups and dumps (never commit proprietary blobs)
/WK7-software-for-unlocked-bootloader/wk7-backup/
*.img
*.bin
wifi.txt*

# Locked-bootloader folder: backups hold verbatim LG firmware images
# (abl, boot, system_b, vbmeta, ...) which must never be committed.
/WK7-software-for-locked-bootloader/backups/
/WK7-software-for-locked-bootloader/state/

# Probe logs: keep only markdown documentation
/WK7-software-for-unlocked-bootloader/wk7-probe/*
!/WK7-software-for-unlocked-bootloader/wk7-probe/REPORT.md
!/WK7-software-for-unlocked-bootloader/wk7-probe/MICOM_PROTOCOL.md
