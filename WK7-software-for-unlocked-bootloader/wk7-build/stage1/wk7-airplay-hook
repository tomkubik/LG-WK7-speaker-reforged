#!/bin/sh
# shairport-sync sessioncontrol hook: tells wk7-moode that AirPlay is playing (via wk7-source-flag),
# so the moOde source steps aside, and hands back when AirPlay stops. Each new AirPlay session starts
# at the phone/Mac volume: the speaker-button AirPlay trim is reset to 100 (no change).
#   sessioncontrol = {
#     run_this_before_entering_active_state = "/usr/local/bin/wk7-airplay-hook start";
#     run_this_after_exiting_active_state  = "/usr/local/bin/wk7-airplay-hook stop";
#   };
FLAG=/run/wk7/airplay-active
mkdir -p /run/wk7
case "$1" in
  start) echo 100 > /run/wk7.airplay-volume.tmp && mv /run/wk7.airplay-volume.tmp /run/wk7.airplay-volume; : > "$FLAG"
         # newest source wins: AirPlay takes over from Spotify (restarting spotifyd ends its session)
         [ -e /run/wk7/spotify-active ] && { rm -f /run/wk7/spotify-active; wk7ctl restart spotify >/dev/null 2>&1 & } ;;
  stop)  rm -f "$FLAG" ;;
esac
/usr/local/bin/wk7-source-flag
