within about a minute and a half and you can try again. <a href="/rescan">Scan again</a></div></section></main></body></html>"""

DONE = """<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>WK7 Setup</title><style>body{font:16px/1.45 -apple-system,system-ui,sans-serif;max-width:480px;margin:0 auto;padding:16px}</style>
</head><body><h1>Joining %s…</h1><p>The speaker is leaving WK7-Setup now. Reconnect your phone to your own Wi-Fi.
In about a minute the speaker's page is at <b>http://wk7.local/</b>. If WK7-Setup reappears instead, the password
was probably wrong: join WK7-Setup again and retry.</p></body></html>"""


class Setup:
    def __init__(self):
        self.networks, self.error, self.choice = [], "", None
        self.done = threading.Event()


def make_handler(state):
    class Handler(BaseHTTPRequestHandler):
        def send(self, code, body):
            data = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def page(self):
            opts = "".join('<option value="%s">%s%s</option>' % (html.escape(s, True), html.escape(s),
                           "" if sec else " (open)") for s, _, sec in state.networks)
            msg = '<p class="err">%s</p>' % html.escape(state.error) if state.error else ""
            self.send(200, PAGE.replace("{options}", opts).replace("{msg}", msg))

        def do_GET(self):
            if self.path.startswith("/rescan"):
                state.choice = ("__rescan__", "")
                state.done.set()
                return self.send(200, "<meta http-equiv=refresh content='20;url=/'>Scanning… this page reloads in 20 s.")
            self.page()                                    # every URL gets the setup page (captive portal)

        def do_POST(self):
            n = int(self.headers.get("Content-Length") or 0)
            form = parse_qs(self.rfile.read(n).decode(errors="replace"))
            ssid = (form.get("other", [""])[0].strip() or form.get("net", [""])[0]).strip()
            pw = form.get("pw", [""])[0]
            if not ssid or len(ssid.encode()) > 32:
                state.error = "Pick a network or type its name."
                return self.page()
            if pw and not (8 <= len(pw) <= 63 or re.fullmatch(r"[0-9a-fA-F]{64}", pw)):
                state.error = "Wi-Fi passwords are 8 to 63 characters."
                return self.page()
            self.send(200, DONE % html.escape(ssid))
            state.choice = (ssid, pw)
            state.done.set()

        def log_message(self, *a):
            pass
    return Handler


def run():
    os.makedirs(os.path.dirname(FLAG), exist_ok=True)
    open(FLAG, "w").close()
    state = Setup()
    log("setup mode start")
    subprocess.run(["wk7ctl", "stop", "dashboard"], capture_output=True)   # the setup page needs port 80
    for attempt in range(30):
        try:
            srv = ThreadingHTTPServer(("", 80), make_handler(state))
            break
        except OSError as e:
            if attempt == 29:
                log("port 80 busy, giving up:", e)
                raise
            time.sleep(1)
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    failures = 0
    try:
        # Android's Wi-Fi stays off during setup (it gave up at boot, and wk7-usbroute did not restart it);
        # "svc wifi disable" here would unload the driver and take wlan0 away
        while True:
            wait_wlan0()
            state.networks = scan()
            log("networks found:", len(state.networks))
            iface = start_ap()
            if not iface:
                failures += 1
                if failures >= 6:
                    log("access point failed %d times, giving up" % failures)
                    return 1
                time.sleep(10)
                continue
            failures = 0
            state.done.clear()
            state.done.wait()
            time.sleep(2)                                  # let the phone receive the reply page
            stop_ap(iface)
            ssid, pw = state.choice
            if ssid == "__rescan__":
                continue
            save_network(ssid, pw)
            if join():
                return 0
            log("could not join", repr(ssid), "-> back to setup")
            state.error = 'Could not join "%s". Check the password and try again.' % ssid
            forget()
    finally:
        srv.shutdown()
        try:
            os.remove(FLAG)
        except OSError:
            pass


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "has-network":
        sys.exit(0 if has_network() else 1)
    if cmd == "forget":
        forget()
        sys.exit(0)
    if cmd == "run":
        sys.exit(run())
    print(__doc__)
    sys.exit(2)
